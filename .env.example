# ═══════════════════════════════════════════════
# Amazon Clone — Environment Variables Template
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Database ──
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=amazon_clone

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT Security ──
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-this
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (Gmail SMTP) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com

# ── Payment Gateways ──
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Firebase (Push Notifications) ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# ── OpenAI (Product Recommendations) ──
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4

# ── Elasticsearch ──
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ── Application URLs ──
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# ── Frontend (Vite) ──
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
